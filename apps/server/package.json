{
  "name": "@openchat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./artifacts-sign": "./src/artifacts-sign.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke:remote": "tsx src/smoke-cli.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:image": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.mjs --log-level=warning --legal-comments=none"
  },
  "dependencies": {
    "@openchat/code-ticket": "workspace:*",
    "@openchat/contracts": "workspace:*",
    "@openchat/opencode": "workspace:*",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
