{
  "name": "openchat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "node scripts/lint-i18n.ts && pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @openchat/web run test:e2e",
    "stt:fetch": "node scripts/stt-fetch.ts",
    "stt:smoke": "node scripts/stt-smoke.ts",
    "release:version": "node scripts/release.ts version",
    "release:bump": "node scripts/release.ts bump",
    "release:changelog": "node scripts/release.ts changelog",
    "release:check": "node scripts/release.ts check",
    "gates:fast": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && ratchet check --tier fast",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "@openchat/contracts": "workspace:*"
  }
}
