# Host-only stack configuration. Copy to `.env` beside compose.yaml, fill in the
# secrets, then `chmod 600 .env`. Never commit it; the repository ignores it.
#
#   install -m 600 deploy/env.example /opt/stacks/openchat/.env
#
# Empty secrets are intentional: compose interpolation refuses to start when one
# is missing, so an unfilled template fails loudly instead of booting with a
# guess. Generate the three random values with:
#
#   openssl rand -base64 32   # SESSION_SECRET
#   openssl rand -base64 32   # CODE_TICKET_SECRET
#   openssl rand -base64 32   # ARTIFACT_SIGNING_KEY
#   openssl rand -base64 24   # OPENCODE_PASSWORD (also set in OpenCode)

# --- Public origins (the only place domains appear) ---
APP_ORIGIN=https://chat.example.com
CODE_HOST_ORIGIN=https://code.example.com
ARTIFACT_HOST_URL=https://artifacts.example.com

# --- Published loopback ports (the edge proxy terminates TLS) ---
BFF_PORT=8787
ARTIFACT_PORT=4100

# --- Auth ---
AUTH_MODE=session
OPENCHAT_USER=owner
# One credential in exactly one shape. A plaintext password is the simple path;
# a bcrypt digest (`caddy hash-password`) lets a takeover from another stack
# reuse its hash without knowing the plaintext. Both set, or neither, fails the
# boot.
#
# Compose interpolates `$…` in env-file values. A bcrypt digest therefore has to
# be written with every `$` doubled: `$$2b$$12$$…`, never `$2b$12$…` — the
# latter renders as `$2b$12` and login can never succeed. The same applies to a
# plaintext password containing `$`. deploy/remote/env-bootstrap.sh escapes the
# digest it copies; a hand-written .env must do it here too.
OPENCHAT_PASSWORD=
OPENCHAT_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=1
ALLOW_INSECURE_COOKIE=0
# Off by default. Set to 1 only when the edge proxy is the only path to the BFF
# and the Code host and appends (or overwrites) X-Forwarded-For: a directly
# reachable port with TRUST_PROXY=1 lets a local client spoof its throttle key.
TRUST_PROXY=0

# --- OpenCode ---
# Point this at an existing service to leave the local `opencode` profile off.
OPENCODE_URL=http://opencode:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# Only used with `--profile opencode`. The image is the official versioned
# `ghcr.io/anomalyco/opencode` base plus this repository's additions (git,
# ripgrep, Docker CLI, artifact tool), built as `openchat-opencode:<tag>`
# (`deploy/Dockerfile.opencode`). Never `latest`: that tag is the stale 1.x line.
# `OPENCODE_PASSWORD` is forwarded by the BFF, but OpenCode 2.3.2 has no HTTP
# auth of its own; the API is protected by network isolation only.
OPENCODE_DOCKER_HOST=tcp://dind:2375

# --- Code host ---
CODE_TICKET_SECRET=
CODE_TICKET_TTL_SECONDS=60
CODE_SESSION_TTL_SECONDS=43200

# --- Artifact origin ---
ARTIFACT_SIGNING_KEY=
# One value read by two processes: the BFF's `/internal/artifacts` route and the
# artifact MCP tool inside the OpenCode container. 32 characters minimum.
# Distinct from ARTIFACT_SIGNING_KEY: that signs URLs, this authorizes writes.
ARTIFACT_INTERNAL_TOKEN=

# --- Documents service (issue #46) ---
# Bearer token for the Debian documents container on the internal `backend`
# network. POST /fill, /convert and /extract require it, and the `openchat-documents`
# MCP entry in the OpenCode config carries the same value. `openssl rand -hex 32`.
DOCUMENTS_TOKEN=

# --- Dictation (optional) ---
STT_URL=
STT_API_KEY=
DICTATION_MAX_SECONDS=120
DICTATION_MAX_BYTES=26214400

# --- Tool runtime (profiles tools/dind) ---
TOOLBOX_DOCKER_HOST=tcp://dind:2375
