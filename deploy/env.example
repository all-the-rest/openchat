# Host-only stack configuration. Copy to `.env` beside compose.yaml, fill in the
# secrets, then `chmod 600 .env`. Never commit it; the repository ignores it.
#
#   install -m 600 deploy/env.example /opt/stacks/openchat/.env
#
# Empty secrets are intentional: compose interpolation refuses to start when one
# is missing, so an unfilled template fails loudly instead of booting with a
# guess. Generate the three random values with:
#
#   openssl rand -base64 32   # SESSION_SECRET
#   openssl rand -base64 32   # CODE_TICKET_SECRET
#   openssl rand -base64 32   # ARTIFACT_SIGNING_KEY
#   openssl rand -base64 24   # OPENCODE_PASSWORD (also set in OpenCode)

# --- Public origins (the only place domains appear) ---
APP_ORIGIN=https://chat.example.com
CODE_HOST_ORIGIN=https://code.example.com
ARTIFACT_HOST_URL=https://artifacts.example.com

# --- Published loopback ports (the edge proxy terminates TLS) ---
BFF_PORT=8787
ARTIFACT_PORT=4100

# --- Auth ---
AUTH_MODE=session
OPENCHAT_USER=owner
OPENCHAT_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=1
ALLOW_INSECURE_COOKIE=0
TRUST_PROXY=1

# --- OpenCode ---
# Point this at an existing service to leave the local `opencode` profile off.
OPENCODE_URL=http://opencode:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# Only used with `--profile opencode`; pin a verified tag or digest first.
OPENCODE_IMAGE=opencode:2.3.0

# --- Code host ---
CODE_TICKET_SECRET=
CODE_TICKET_TTL_SECONDS=60
CODE_SESSION_TTL_SECONDS=43200

# --- Artifact origin ---
ARTIFACT_SIGNING_KEY=

# --- Dictation (optional) ---
STT_URL=
STT_API_KEY=
DICTATION_MAX_SECONDS=120
DICTATION_MAX_BYTES=26214400

# --- Tool runtime (profiles tools/dind) ---
TOOLBOX_DOCKER_HOST=tcp://dind:2375
