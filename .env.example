# --- Auth (single user) ---
# basic: Caddy or the BFF checks HTTP Basic Auth.
# session: the BFF serves a login form and a signed session cookie.
AUTH_MODE=session
# Username of the only account.
AUTH_USER=owner
# bcrypt hash of the password, e.g. from `caddy hash-password`.
AUTH_PASSWORD_HASH=
# Random secret for signed session cookies (32+ bytes, base64).
AUTH_SECRET=
# Session lifetime in seconds (default 7 days).
SESSION_TTL=604800

# --- OpenCode (internal) ---
# Reachable internally only; never bind it publicly.
# OpenCode 2.3 does not authenticate requests, so the network is the boundary.
OPENCODE_URL=http://127.0.0.1:4096
# Optional: value for the upstream Authorization header when OpenCode is behind
# a Basic-auth gate (see "Production pattern" in 03-auth-deployment.md).
# Leave empty when OpenCode is reachable only over a private network.
OPENCODE_AUTH=
# Same-origin admin proxy for provider/MCP configuration. Keep it off unless
# you actually need it; OpenCode itself must stay unpublished.
ADMIN_PROXY=off

# --- Workspace ---
# Directory OpenCode may read and write. Required for session creation.
WORKSPACE_DIR=/workspace

# --- Artifacts (separate origin) ---
ARTIFACT_HOST_URL=http://localhost:3001
# HMAC key for signed, short-lived artifact URLs (32+ bytes, base64).
ARTIFACT_SIGNING_KEY=

# --- App ---
PORT=3000
# Public origin of the app (for cookies, CSRF and absolute links).
ORIGIN=http://localhost:3000
