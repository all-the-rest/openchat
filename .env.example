# --- Auth (single user) ---
# basic: Caddy or the BFF checks HTTP Basic Auth.
# session: the BFF serves a login form and a signed session cookie.
AUTH_MODE=session
# Username of the only account.
AUTH_USER=owner
# bcrypt hash of the password, e.g. from `caddy hash-password`.
AUTH_PASSWORD_HASH=
# Random secret for signed session cookies (32+ bytes, base64).
AUTH_SECRET=
# Session lifetime in seconds (default 7 days).
SESSION_TTL=604800

# --- OpenCode (internal) ---
# Reachable internally only; never bind it publicly.
OPENCODE_URL=http://127.0.0.1:4096
# OpenCode 2.3 protects its HTTP API with Basic auth (fixed username
# "opencode"). If OPENCODE_PASSWORD is unset in the server process, OpenCode
# generates one and prints it at startup. The BFF sends it on every request.
# OPENCODE_SERVER_PASSWORD is accepted as a legacy alias.
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# Same-origin admin proxy for provider/MCP configuration. Keep it off unless
# you actually need it; OpenCode itself must stay unpublished.
ADMIN_PROXY=off

# --- Code surface (original OpenCode web UI) ---
# on: the Chat | Code switch embeds OpenCode's own UI from CODE_HOST_URL.
CODE_SURFACE=off
# Dedicated authenticated origin, e.g. https://code.example.com.
CODE_HOST_URL=
# HMAC key for single-use tickets (32+ bytes, base64).
CODE_TICKET_SECRET=

# --- Workspace ---
# Directory OpenCode may read and write. Required for session creation.
WORKSPACE_DIR=/workspace

# --- Artifacts (separate origin) ---
ARTIFACT_HOST_URL=http://localhost:3001
# HMAC key for signed, short-lived artifact URLs (32+ bytes, base64).
ARTIFACT_SIGNING_KEY=

# --- Dictation / speech-to-text ---
# Whisper-compatible transcription endpoint. Leave empty to hide dictation.
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Hard limit per recording, in seconds.
STT_MAX_SECONDS=120

# --- Backend / testing ---
# opencode: talk to a real server. fake: deterministic in-process backend with
# scripted events; no provider calls, no quota, no network.
BACKEND_MODE=opencode
# Fake scenario name (only used when BACKEND_MODE=fake).
FAKE_SCENARIO=default
# Set to 1 only for an explicit live smoke test against a real provider.
LIVE_TESTS=0

# --- App ---
PORT=3000
# Public origin of the app (for cookies, CSRF and absolute links).
ORIGIN=http://localhost:3000
