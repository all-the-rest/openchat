# Every variable the BFF reads. Defaults are the values below; a comment says
# when the default is derived at boot. Copy to `.env` for a local run.

# --- Bind address ---
# Loopback by default. Container images set HOST=0.0.0.0 so the published port
# reaches the BFF; never publish the port without the reverse proxy in front.
HOST=127.0.0.1
PORT=8787
# 1: trust X-Forwarded-For / X-Real-IP from a reverse proxy that overwrites
# them. Leave 0 for a direct connection; otherwise a client can spoof its
# rate-limit bucket.
TRUST_PROXY=0

# --- Auth (single user, single password) ---
# basic: HTTP Basic Auth, also usable as a second layer at the edge.
# session: the BFF serves a login form and a signed session cookie (default).
AUTH_MODE=session
# The only username. It is embedded in the session cookie and used by Basic
# auth; the login form asks for the password only.
OPENCHAT_USER=owner
# The only credential. When unset, development uses `openchat-dev` and warns.
# A production boot refuses the default value.
OPENCHAT_PASSWORD=
# Random secret for signed session cookies (32+ bytes). When unset, the server
# generates an ephemeral secret for this boot; a production boot requires it.
SESSION_SECRET=
# Session lifetime in seconds (default 7 days). Fixed lifetime, no renewal.
SESSION_TTL_SECONDS=604800
# 1: mark the session cookie Secure. Required in production with session auth
# unless ALLOW_INSECURE_COOKIE=1 is set explicitly.
COOKIE_SECURE=0
ALLOW_INSECURE_COOKIE=0

# --- Backend ---
# fake: deterministic in-process backend; no provider calls, no quota, no
#       network (default).
# live: a real `opencode serve` instance behind OPENCODE_URL.
BACKEND_MODE=fake
# Fake scenario used when BACKEND_MODE=fake:
# default | rich | reasoning | tools | error | abort | slow
FAKE_SCENARIO=default
# off makes the fake behave like a host without an app surface: /apps is hidden
# and /api/apps reports available=false. Only meaningful with BACKEND_MODE=fake.
FAKE_APPS=on
# Reachable internally only; never bind OpenCode publicly. A remote host works
# over a private network or an SSH tunnel (see docs/architecture/03); a
# malformed value or embedded credentials fail the boot.
OPENCODE_URL=http://127.0.0.1:4096
# OpenCode 2.3 protects its HTTP API with Basic auth (fixed username
# "opencode"). The BFF sends this password on every request; a live boot warns
# when it is empty and OpenCode will answer 401.
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# Directory OpenCode may read and write; the browser never chooses it.
# Defaults to the process working directory.
WORKSPACE_DIR=

# --- Dictation (optional) ---
# Whisper-compatible speech-to-text base URL. The BFF posts to
# ${STT_URL}/audio/transcriptions; include /v1 when the service expects it.
# Empty disables dictation and hides the microphone control.
STT_URL=
# Optional bearer token for the STT service. Never logged.
STT_API_KEY=
# Recording limit advertised to the composer and the upload cap enforced by the
# BFF (bytes). Defaults: 120 seconds, 26214400 bytes (25 MiB); values
# above 104857600 (100 MiB) are clamped with a warning.
DICTATION_MAX_SECONDS=120
DICTATION_MAX_BYTES=26214400

# --- Code surface (optional) ---
# Origin of the Code host that serves OpenCode's own UI. Empty disables the
# surface: no Chat | Code switch, `/code` redirects home. The host must be a
# bare origin without a path and, in production, https.
CODE_HOST_ORIGIN=
# Ticket signing secret, shared with the Code host (`CODE_TICKET_SECRET` there).
# Both processes must carry the same value; two generated development secrets
# silently break the exchange (the host answers 401 "invalid or expired link").
# Production refuses to boot with a configured Code host and no secret.
CODE_TICKET_SECRET=
# Ticket lifetime in seconds, at most 60. The host refuses longer ones.
CODE_TICKET_TTL_SECONDS=60
# Deadline for the Code host health probe behind `/api/code/status`.
CODE_STATUS_TIMEOUT_MS=2000

# --- Runtime ---
# production refuses BACKEND_MODE=fake, the default password, an ephemeral
# session secret and an insecure session cookie (unless explicitly allowed).
NODE_ENV=development
