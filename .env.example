# Every variable the BFF and the Code host read. Defaults are the values below;
# a comment says when the default is derived at boot. Copy to `.env` for a
# local run.

# --- Bind address ---
# Loopback by default. Container images set HOST=0.0.0.0 so the published port
# reaches the BFF; never publish the port without the reverse proxy in front.
HOST=127.0.0.1
PORT=8787
# 1: trust X-Forwarded-For / X-Real-IP from exactly one reverse proxy that
# appends the hop it observed (nginx $proxy_add_x_forwarded_for, Traefik).
# Leave 0 for a direct connection; otherwise a client can spoof its
# rate-limit bucket. See docs/implementation/11-proxy-addressing.md.
TRUST_PROXY=0

# --- Auth (single user, username + password) ---
# basic: HTTP Basic Auth, also usable as a second layer at the edge.
# session: the BFF serves a login form and a signed session cookie (default).
AUTH_MODE=session
# The only username. It is embedded in the session cookie, used by Basic auth
# and compared before the password at login.
OPENCHAT_USER=owner
# Exactly one credential. OPENCHAT_PASSWORD is plaintext; OPENCHAT_PASSWORD_HASH
# is a bcrypt hash (`$2a$`/`$2b$`/`$2y$`, 60 characters) that lets a takeover
# reuse an existing hash without knowing the password. Setting both, or
# neither, fails the boot. A production deployment refuses neither source.
OPENCHAT_PASSWORD=
OPENCHAT_PASSWORD_HASH=
# Random secret for signed session cookies (32+ bytes). When unset, the server
# generates an ephemeral secret for this boot; a production boot requires it.
SESSION_SECRET=
# Session lifetime in seconds (default 7 days). Fixed lifetime, no renewal.
SESSION_TTL_SECONDS=604800
# 1: mark the session cookie Secure. Required in production with session auth
# unless ALLOW_INSECURE_COOKIE=1 is set explicitly.
COOKIE_SECURE=0
ALLOW_INSECURE_COOKIE=0

# --- Backend ---
# fake: deterministic in-process backend; no provider calls, no quota, no
#       network (default).
# live: a real `opencode serve` instance behind OPENCODE_URL.
BACKEND_MODE=fake
# Fake scenario used when BACKEND_MODE=fake:
# default | rich | reasoning | tools | error | abort | slow
FAKE_SCENARIO=default
# off makes the fake behave like a host without an app surface: /apps is hidden
# and /api/apps reports available=false. Only meaningful with BACKEND_MODE=fake.
FAKE_APPS=on
# Reachable internally only; never bind OpenCode publicly. A remote host works
# over a private network or an SSH tunnel (see docs/architecture/03); a
# malformed value or embedded credentials fail the boot.
OPENCODE_URL=http://127.0.0.1:4096
# OpenCode 2.3 protects its HTTP API with Basic auth (fixed username
# "opencode"). The BFF sends this password on every request; a live boot warns
# when it is empty and OpenCode will answer 401.
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# Directory OpenCode may read and write; the browser never chooses it.
# Defaults to the process working directory.
WORKSPACE_DIR=

# --- Dictation (optional) ---
# Whisper-compatible speech-to-text base URL. The BFF posts to
# ${STT_URL}/audio/transcriptions; include /v1 when the service expects it.
# Empty disables dictation and hides the microphone control.
STT_URL=
# Optional bearer token for the STT service. Never logged.
STT_API_KEY=
# Recording limit advertised to the composer and the upload cap enforced by the
# BFF (bytes). Defaults: 120 seconds, 26214400 bytes (25 MiB); values
# above 104857600 (100 MiB) are clamped with a warning.
DICTATION_MAX_SECONDS=120
DICTATION_MAX_BYTES=26214400

# --- Code surface (optional) ---
# Origin of the Code host that serves OpenCode's own UI. Empty disables the
# surface: no Chat | Code switch, `/code` redirects home. The host must be a
# bare origin without a path and, in production, https.
CODE_HOST_ORIGIN=
# Ticket signing secret, shared with the Code host (`CODE_TICKET_SECRET` there).
# Both processes must carry the same value; two generated development secrets
# silently break the exchange (the host answers 401 "invalid or expired link").
# Production refuses to boot with a configured Code host and no secret.
CODE_TICKET_SECRET=
# Ticket lifetime in seconds, at most 60. The host refuses longer ones.
CODE_TICKET_TTL_SECONDS=60
# Deadline for the Code host health probe behind `/api/code/status`.
CODE_STATUS_TIMEOUT_MS=2000

# --- Code host (apps/code-host, optional) ---
# The Code host is a second process with its own environment. It reads HOST,
# PORT (default 8090, not 8787), OPENCODE_URL, OPENCODE_USERNAME,
# OPENCODE_PASSWORD, CODE_HOST_ORIGIN, CODE_TICKET_SECRET,
# CODE_TICKET_TTL_SECONDS, COOKIE_SECURE, ALLOW_INSECURE_COOKIE and TRUST_PROXY
# under the names documented above. Two settings exist only for it:
# Public origin of the app; the only origin allowed to frame the host.
APP_ORIGIN=
# Lifetime of the host's own session cookie in seconds (default 12 h, capped at
# 30 days). The ticket stays the short-lived hand-in; this cookie is what the
# framed UI keeps.
CODE_SESSION_TTL_SECONDS=43200

# --- Artifact host (optional) ---
# Interactive artifacts are stored by the BFF and served from a separate origin
# (`apps/artifact-host`). The surface is available only when BOTH the host URL
# and the signing key are set; with either unset the UI hides artifacts, create
# and read answer 503 and the list answers empty. The server still boots.
#
# Public base URL of the artifact host, e.g. http://localhost:4100. A bare
# http(s) URL without credentials, query or fragment; https in production.
ARTIFACT_HOST_URL=
# Shared HMAC key for signed artifact URLs, at least 32 characters. The artifact
# host refuses to boot without it. Both processes must carry the same value and
# it is never logged. `openssl rand -base64 32`.
ARTIFACT_SIGNING_KEY=
# Storage directory for artifact documents. The artifact host reads the same
# directory (mount it read-only) and never writes. Defaults to
# <WORKSPACE_DIR>/.openchat-artifacts.
ARTIFACTS_DIR=
# Bearer token for POST /internal/artifacts, the write route the MCP tool
# (packages/artifact-tool) calls. Both processes must carry the SAME value; a
# production boot with the artifact surface configured refuses to start without
# it, and a development boot generates an ephemeral token that the tool cannot
# know. At least 32 characters. `openssl rand -base64 32`.
ARTIFACT_INTERNAL_TOKEN=
# Bearer token for POST /internal/memory, the write route the memory MCP tool
# (packages/memory-tool) calls (issue #49). The BFF and the tool must carry the
# SAME value: production refuses to boot without it, and a development boot
# generates an ephemeral token the tool can never match. At least 32 characters.
# `openssl rand -base64 32`.
MEMORY_INTERNAL_TOKEN=
# Bearer token for the headless documents service (issue #46). It authorizes
# POST /fill, /convert and /extract on `documents:8099` and is distinct from the
# BFF token. Both the service and the documents MCP entry read the same value;
# at least 32 characters, `openssl rand -hex 32`.
DOCUMENTS_TOKEN=
# Artifact host only: the chat origin allowed to frame an artifact document.
# Defaults to the Vite dev server. A deployment sets it to the chat origin,
# e.g. https://chat.example.com.
ARTIFACT_FRAME_ANCESTORS=http://localhost:5173

# --- Runtime ---
# production refuses BACKEND_MODE=fake, an unset login credential, an ephemeral
# session secret and an insecure session cookie (unless explicitly allowed).
NODE_ENV=development
# Built SPA directory. Empty in development: Vite serves the shell and proxies
# /api to the BFF. The container image sets /app/web so the BFF serves the build
# on the same origin as the API (see docs/implementation/14-deployment.md).
WEB_DIST_DIR=

# Compact a chat before a prompt once its reported context reaches this many
# tokens; 0 disables the BFF-side guard (host policy still applies).
CHAT_CONTEXT_SOFT_CAP=200000
# --- Model fallback (optional, chat only) ---
# Ordered JSON array of model candidates the chat turn may try after a
# retryable failure, e.g. [{"providerID":"p","modelID":"m","isFree":true}].
# Empty disables fallback entirely; an invalid value is ignored at startup with
# one warning.
FALLBACK_CHAIN_JSON=
# Paid turns allowed per local day. Free models never count. 0 disables the cap;
# free entries in the chain remain reachable when it is exhausted.
FALLBACK_PAID_DAILY_CAP=0
# Directory holding the per-day usage ledger files.
FALLBACK_USAGE_DIR=/workspace/chats/.usage
